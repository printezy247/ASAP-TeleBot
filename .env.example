# Copy this file to .env and fill in real values. Never commit .env.
# This one file holds settings for BOTH bots in this repo (asap_telebot and ezymap_bot).

# --- asap_telebot (A$AP USD) ---

# Token from @BotFather
BOT_TOKEN=

# Your (admin) numeric Telegram chat ID, e.g. from @userinfobot
ADMIN_CHAT_ID=

# Only needed for webhook hosting (e.g. PythonAnywhere) - see README.
# Any long random string, e.g. generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# --- ezymap_bot (EzyMap Algo) ---

# Token for the SECOND bot, from @BotFather (create a separate bot for this)
EZYMAP_BOT_TOKEN=

# Jack's (admin) numeric Telegram chat ID, e.g. from @userinfobot
EZYMAP_ADMIN_CHAT_ID=

# Only needed for webhook hosting - a different random string than WEBHOOK_SECRET above
EZYMAP_WEBHOOK_SECRET=

# Optional - only needed for the Xendit (card/bank/e-wallet) payment option. Leave blank
# until you've signed up with Xendit and created a Secret API Key in their dashboard.
EZYMAP_XENDIT_SECRET_KEY=

# The "Verification Token" shown when you add a webhook callback in the Xendit
# dashboard (Settings -> Webhooks). Used to confirm callbacks really came from Xendit.
EZYMAP_XENDIT_CALLBACK_TOKEN=

# Optional - native Telegram Payments providers, connected via @BotFather -> your bot ->
# Payments. Leave blank until you've connected the provider there; the corresponding
# payment button will show a friendly "not set up yet" message instead of erroring.
# BotFather gives you a provider token immediately after you connect each one.
EZYMAP_IPAY88_PROVIDER_TOKEN=
EZYMAP_SMARTGLOCAL_PROVIDER_TOKEN=
